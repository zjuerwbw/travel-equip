page {
  background: #f2f4f7;
  font-size: 28rpx;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(29, 78, 116, 0.05);
}
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.col { flex: 1; }
.grow { flex-grow: 1; }
.input {
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1d1d1f;
}
.label { color: #86868b; font-size: 24rpx; margin: 26rpx 6rpx 10rpx; display: block; }
.btn {
  background: #32ade6;
  color: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 24rpx;
  transition: opacity 0.15s;
}
.btn:active { opacity: 0.8; }
.btn-plain { background: #e8f5fd; color: #1c87d6; border: none; }
.btn-danger { background: #feeeee; color: #ff3b30; border: none; }
.btn-warn { background: #fff4e5; color: #ff9500; border: none; }
.btn.disabled { opacity: 0.4; }
.chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #6e6e73;
  border: 2rpx solid #e8eaee;
  display: inline-block;
  white-space: nowrap;
  transition: all 0.15s;
}
.chip.active {
  background: #32ade6;
  color: #ffffff;
  border-color: #32ade6;
  font-weight: 500;
}
.muted { color: #86868b; font-size: 24rpx; }
.weight { color: #1c87d6; font-weight: 600; }
.tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: #e8f5fd;
  color: #1c87d6;
  margin-left: 12rpx;
}
.tag.gray { background: #f2f2f5; color: #86868b; }
.tag.red { background: #feeeee; color: #ff3b30; }
.tag.orange { background: #fff4e5; color: #ff9500; }
.section-title { font-weight: 600; margin: 30rpx 26rpx 8rpx; font-size: 30rpx; color: #1d1d1f; }
.divider { height: 2rpx; background: #f0f1f4; margin: 22rpx 0; }
.empty { text-align: center; color: #b9bdc4; padding: 110rpx 0; font-size: 26rpx; }
.empty .icon { font-size: 84rpx; display: block; margin-bottom: 20rpx; }
.fab {
  position: fixed;
  right: 36rpx;
  bottom: 64rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #32ade6;
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(50, 173, 230, 0.4);
  z-index: 10;
}
.fab:active { opacity: 0.85; }
