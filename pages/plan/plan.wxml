<view class="tab-bar row">
  <view class="chip {{activeTab === item.key ? 'active' : ''}}"
    wx:for="{{tabs}}" wx:key="key" bindtap="onTab" data-key="{{item.key}}">{{item.name}}</view>
</view>

<view wx:if="{{!list.length}}" class="empty">
  <text class="icon">📋</text>
  暂无计划，点击右下角 + 创建
</view>

<view class="card plan-item" wx:for="{{list}}" wx:key="id" bindtap="onItem" data-id="{{item.id}}">
  <view class="row between">
    <view class="p-name">{{item.name}}</view>
    <view class="tag {{item.reviewed ? '' : 'orange'}}">{{item.statusText}}</view>
  </view>
  <view class="muted" style="margin-top:10rpx">📍 {{item.destination}} <text wx:if="{{item.altitude}}">（海拔 {{item.altitude}}）</text></view>
  <view class="row between" style="margin-top:10rpx">
    <text class="muted">📅 {{item.date}} · {{item.days}}天</text>
    <text class="weight">{{item.weight}}</text>
  </view>
</view>

<view class="fab" bindtap="onAdd">+</view>
