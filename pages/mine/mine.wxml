<view class="card">
  <view class="m-title">户外装备管家</view>
  <view class="muted">V1.0 · 装备 / 计划 / 打包 / 复盘</view>
</view>

<view class="card row">
  <view class="col" style="text-align:center">
    <view class="m-num">{{gearCount}}</view>
    <view class="muted">装备</view>
  </view>
  <view class="col" style="text-align:center">
    <view class="m-num">{{planCount}}</view>
    <view class="muted">出行</view>
  </view>
  <view class="col" style="text-align:center">
    <view class="m-num">{{reviewedCount}}</view>
    <view class="muted">已复盘</view>
  </view>
  <view class="col" style="text-align:center">
    <view class="m-num">{{totalWeight}}</view>
    <view class="muted">装备总重</view>
  </view>
</view>

<view class="card">
  <view class="m-row row between">
    <text>📦 数据说明</text>
    <text class="muted">本地存储，随微信账号保留</text>
  </view>
  <view class="divider"></view>
  <view class="m-row row between" bindtap="onClear">
    <text style="color:#e5484d">🗑 清空所有数据</text>
  </view>
</view>
